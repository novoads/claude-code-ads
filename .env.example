# Copy this file to .env and add your key (never commit .env).
# ./scripts/setup.sh does this for you and validates the key before writing it.

# ── Your Novoads API key ─────────────────────────────────────────────────────
# Format: novo_ followed by 64 hex characters.
# Create one at https://novoads.ai/dashboard/settings?tab=api
# Need an account? Start your $1 trial:
#   https://novoads.ai/?utm_source=claude-code&utm_medium=github&utm_campaign=skill-pack
NOVOADS_API_KEY=novo_your_key_here

# ── Optional ─────────────────────────────────────────────────────────────────
# Override only if you were given a different host. The default is correct for
# every account. This is the HOST ONLY — callers append /v1/…, so no trailing
# slash and no /v1 here.
# NOVOADS_BASE_URL=https://api.novoads.ai

# ── Meta Ads (meta-ad-builder shared skill — OPTIONAL) ───────────────────────
# Powers shared/skills/meta-ad-builder/ — publishing creatives as Meta ads.
# Uncomment + fill these in ONLY if you'll publish via the Meta Marketing API.
# Every ad created by the skill is PAUSED — you launch manually in Ads Manager.
# Token needs the ads_management scope.
# META_ACCESS_TOKEN=your_long_lived_token_here
# META_AD_ACCOUNT_ID=act_1234567890
# META_PAGE_ID=
# META_IG_USER_ID=
# META_PIXEL_ID=
# META_API_VERSION=v23.0
